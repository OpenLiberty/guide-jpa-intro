<server description="Sample Liberty server">

  <featureManager>
    <platform>jakartaee-11.0</platform>
    <feature>restfulWS</feature>
    <feature>jsonb</feature>
    <feature>jsonp</feature>
    <feature>cdi</feature>
    <feature>persistence</feature>
  </featureManager>

  <variable name="http.port" defaultValue="5050" />
  <variable name="https.port" defaultValue="5051" />

  <httpEndpoint httpPort="${http.port}" httpsPort="${https.port}"
                id="defaultHttpEndpoint" host="*" />

  <application location="backendServices.war" type="war" context-root="/"></application>

  <!-- H2 Library Configuration -->
   <!-- tag::shared-dir[] -->
  <library id="h2JDBCLib">
    <fileset dir="${shared.resource.dir}/" includes="h2*.jar" />
  </library>
  <!-- end::shared-dir[] -->

  <!-- Datasource Configuration -->
  <!-- tag::data-source[] -->
  <dataSource id="eventjpadatasource" jndiName="jdbc/eventjpadatasource">
    <jdbcDriver libraryRef="h2JDBCLib" />
    <properties.h2 URL="jdbc:h2:${server.output.dir}/EventDB" />
  </dataSource>
  <!-- end::data-source[] -->

</server>
